# systemd *user* unit — HoverClock runs in the graphical session as the
# logged-in user (needs X11 access; never root).
#
# Wanted by *both* default.target and graphical-session.target, because
# which target a desktop raises at login differs:
#   - GNOME/KDE raise graphical-session.target when the session is ready
#   - xfce/XFCE-style sessions (e.g. MX Linux) never raise it — the user
#     session goes straight to default.target
# With both WantedBy entries the daemon starts exactly once either way
# (the first target that raises pulls it in; the second finds it active).
# Stop/start with:
#   systemctl --user stop hover-clock
#   systemctl --user start hover-clock

[Unit]
Description=HoverClock — transient overlay daemon (clock on demand)
After=default.target graphical-session.target
PartOf=graphical-session.target
# Cap restart churn: if the unit is ever started while the binary is
# missing (dev mode — swap-to-dev stashes it), stop retrying after 5
# failures in a minute instead of looping forever (Restart=on-failure).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/hover-clock --start
Restart=on-failure
RestartSec=3
# Only needed if DISPLAY/XAUTHORITY are not in the user manager
# environment at login (console login + manual startx):
# Environment=DISPLAY=:0 XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=default.target graphical-session.target
